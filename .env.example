# Optional support fallback: configure verified limits/rates, then run the budgeted canary
# with --model=<exact fallback ID>. Empty/zero values keep fallback unusable.
SUPPORT_AI_FALLBACK_MODEL=
SUPPORT_AI_FALLBACK_CONTEXT_TOKENS=0
SUPPORT_AI_FALLBACK_OUTPUT_TOKENS=0
SUPPORT_AI_FALLBACK_INPUT_MICRO_EUR_PER_TOKEN=0
SUPPORT_AI_FALLBACK_OUTPUT_MICRO_EUR_PER_TOKEN=0
SUPPORT_AI_FALLBACK_PRICING_REFERENCE=

# Moneybird: explicit operator actions only; senior supplies actual reviewed IDs/contact mapping in config/moneybird.php.
MONEYBIRD_ENABLED=false
MONEYBIRD_ALLOW_DELIVERY=false
MONEYBIRD_API_TOKEN=
MONEYBIRD_ADMINISTRATION_ID=
MONEYBIRD_IDENTITY_ID=
MONEYBIRD_MAPPING_REFERENCE=
MONEYBIRD_REWARD_TAX_RATE_ID=
MONEYBIRD_REWARD_LEDGER_ACCOUNT_ID=
MONEYBIRD_FEE_TAX_RATE_ID=
MONEYBIRD_FEE_LEDGER_ACCOUNT_ID=
MONEYBIRD_WORKFLOW_ID=

# Enable only after the BigCommerce cart/order metafield bridge and read permissions are configured.
BIGCOMMERCE_ASSIGNMENT_METADATA_ENABLED=false
# Native cart UUID -> verified order cart_id; requires migration and opt-in storefront reader.
BIGCOMMERCE_CART_ASSIGNMENTS_ENABLED=false

# Opt-in native widget provisioning; actual Content modify authority and provider acceptance required.
BIGCOMMERCE_BANNERS_ENABLED=false

# CMS raster derivatives (requires GD WebP and a worker on this connection).
CMS_MEDIA_QUEUE_CONNECTION=database

# Disabled until reviewed staging scripts, target and deployment hook are configured.
QA_STAGING_RUNNER_ENABLED=false
QA_STAGING_URL=
QA_STAGING_LOCK_STORE=database

# Optional: Reverb-allowed origin for the scheduled synthetic private-channel probe.
# SUPPORT_AI_REVERB_PROBE_ORIGIN=https://shopbonus.example
