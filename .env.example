APP_NAME=Shopbonus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopbonus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Never use the log mailer outside local dev: mail bodies (codes, reset links) would be written to logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HEALTH_READINESS_TOKEN=
API_RATE_LIMIT_PER_MINUTE=60
# Browsable docs at /docs. Defaults to on outside production.
#API_DOCS_ENABLED=true

# Published legal document versions (until the CMS publishes them). Empty = registration disabled.
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_MARKETING_CONSENT_VERSION=

# Sanctum SPA (cookie) auth. Production: SESSION_SECURE_COOKIE=true, SESSION_DOMAIN=.shopbonus.nl
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Google Places API (New) for business search. Empty = manual entry only.
GOOGLE_PLACES_API_KEY=

# Answer24: outbound dispatch stays off until contract + lawful basis are confirmed.
ANSWER24_DISPATCH_ENABLED=false
ANSWER24_BASE_URL=
ANSWER24_SIGNING_SECRET=
ANSWER24_ALLOW_LEGITIMATE_INTEREST=false
ANSWER24_RECENT_CONTACT_DAYS=30
# Shopbonus-defined contract paths (OPEN-ANSWER24-CONTRACT); override once Answer24 confirms.
#ANSWER24_CONTACT_PATH=/api/shopbonus/v1/contact-requests
#ANSWER24_CANCEL_PATH=/api/shopbonus/v1/contact-requests/{reference}/cancel
#ANSWER24_CLAIM_STATUS_PATH=/api/shopbonus/v1/claims/{reference}/status

# Super Admin security (B16a): TOTP 2FA required for admin routes; emailed step-up code; support sessions.
ADMIN_MFA_REQUIRED=true
ADMIN_STEP_UP_CODE_TTL_MINUTES=10
ADMIN_STEP_UP_MAX_ATTEMPTS=5
ADMIN_STEP_UP_VALID_MINUTES=10
ADMIN_SUPPORT_SESSION_MINUTES=30
