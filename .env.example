APP_NAME=Shopbonus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3000
# SPA paths used in emails, the inbox and support actions (config shopbonus.identity.frontend_paths).
# Override to match the frontend router, e.g. FRONTEND_PATH_CONSUMER_BENEFITS=/mijn-voordelen
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true
# Use one hostname consistently: localhost and 127.0.0.1 do not share cookies.
# CORS entries are full origins; SANCTUM_STATEFUL_DOMAINS entries are host:port only.

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopbonus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=shopbonus_session
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
# Optional database session connection; null uses the default database connection.
SESSION_CONNECTION=null
SESSION_TABLE=sessions
SESSION_STORE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
# Must exceed the queue worker --timeout (recommended 60 seconds).
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# Never use the log mailer outside local dev: mail bodies (codes, reset links) would be written to logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HEALTH_READINESS_TOKEN=
API_RATE_LIMIT_PER_MINUTE=60
# Browsable docs at /docs. Defaults to on outside production.
#API_DOCS_ENABLED=true

# Published legal document versions (until the CMS publishes them). Empty = registration disabled.
LEGAL_TERMS_VERSION=terms-2026-10
LEGAL_PRIVACY_VERSION=privacy-2026-10
LEGAL_MARKETING_CONSENT_VERSION=marketing-2026-10

# Sanctum SPA (cookie) auth. Production: SESSION_SECURE_COOKIE=true, SESSION_DOMAIN=.shopbonus.nl
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Current HTTPS deployment on www.shopbonus.nl + app.shopbonus.nl:
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://app.shopbonus.nl
# FRONTEND_URL=https://www.shopbonus.nl, CORS_ALLOWED_ORIGINS=https://www.shopbonus.nl
# SANCTUM_STATEFUL_DOMAINS=www.shopbonus.nl, SESSION_DOMAIN=.shopbonus.nl
# SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=lax (same-site subdomains).
# Share the parent cookie domain so the SPA can read XSRF-TOKEN; session stays HttpOnly.
# Unrelated frontend/API domains need a same-site proxy; third-party cookies are unreliable.
# After env changes: php artisan optimize:clear; restart queue workers and rebuild Next.js.

# Registration verification: queued mandatory account mail (independent of marketing opt-in).
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Sensitive owner permissions keep MFA and recent password/email step-up enabled.
OWNER_MFA_REQUIRED=true
OWNER_STEP_UP_REQUIRED=true

# Google Places API (New) for business search. Empty = manual entry only.
GOOGLE_PLACES_API_KEY=

# Answer24: outbound dispatch stays off until contract + lawful basis are confirmed.
ANSWER24_DISPATCH_ENABLED=false
ANSWER24_BASE_URL=
ANSWER24_SIGNING_SECRET=
ANSWER24_ALLOW_LEGITIMATE_INTEREST=false
ANSWER24_RECENT_CONTACT_DAYS=30
# Shopbonus-defined contract paths (OPEN-ANSWER24-CONTRACT); override once Answer24 confirms.
#ANSWER24_CONTACT_PATH=/api/shopbonus/v1/contact-requests
#ANSWER24_CANCEL_PATH=/api/shopbonus/v1/contact-requests/{reference}/cancel
#ANSWER24_CLAIM_STATUS_PATH=/api/shopbonus/v1/claims/{reference}/status

# Super Admin security (B16a): TOTP 2FA required for admin routes; emailed step-up code; support sessions.
ADMIN_MFA_REQUIRED=true
ADMIN_STEP_UP_CODE_TTL_MINUTES=10
ADMIN_STEP_UP_MAX_ATTEMPTS=5
ADMIN_STEP_UP_VALID_MINUTES=10
ADMIN_SUPPORT_SESSION_MINUTES=30

# Card #21 advisory-only diagnostics. Configure a supported Responses model before enabling.
ADMIN_DIAGNOSTICS_ENABLED=false
OPENAI_API_KEY=
ADMIN_DIAGNOSTICS_MODEL=
ADMIN_DIAGNOSTICS_DAILY_REQUEST_LIMIT=10
ADMIN_DIAGNOSTICS_MAX_OUTPUT_TOKENS=1500

# Enable after senior developer configures an authorized TradeTracker account.
TRADETRACKER_API_ENABLED=false

# Banner design/insight suggestions; credentials/model configured by senior developer.
BANNER_AI_ENABLED=false
BANNER_AI_MODEL=
BANNER_AI_DAILY_REQUEST_LIMIT=10
BANNER_AI_MAX_OUTPUT_TOKENS=2000

# Merchant public-profile enrichment (website research + Dutch copy + optional header image). Human review by default.
MERCHANT_ENRICHMENT_ENABLED=false
MERCHANT_ENRICHMENT_TEXT_MODEL=
MERCHANT_ENRICHMENT_IMAGE_MODEL=
MERCHANT_ENRICHMENT_DAILY_RUN_LIMIT=50
MERCHANT_ENRICHMENT_MAX_OUTPUT_TOKENS=2000
MERCHANT_ENRICHMENT_FETCH_MAX_BYTES=262144
MERCHANT_ENRICHMENT_AUTO_PUBLISH=false
MERCHANT_ENRICHMENT_STALE_DAYS=90

# Verified support: senior developer configures an account-supported model and publishes support.ai settings.
# Support execution guards: configure from verified exact-model limits/pricing, then run canary.
SUPPORT_AI_DAILY_COST_LIMIT_EUR=20
SUPPORT_AI_CONTRACT_TTL_HOURS=24
SUPPORT_AI_CONTEXT_TOKENS=0
SUPPORT_AI_CONTRACT_OUTPUT_TOKENS=0
SUPPORT_AI_INPUT_MICRO_EUR_PER_TOKEN=0
SUPPORT_AI_OUTPUT_MICRO_EUR_PER_TOKEN=0
SUPPORT_AI_PRICING_REFERENCE=
SUPPORT_AI_ENABLED=false
SUPPORT_AI_MODEL=
SUPPORT_AI_DAILY_REQUEST_LIMIT=100
SUPPORT_AI_USER_DAILY_REQUEST_LIMIT=20
SUPPORT_AI_MAX_OUTPUT_TOKENS=1000
SUPPORT_AI_TIMEOUT_SECONDS=20
SUPPORT_AI_RETENTION_DAYS=30
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=

# Central notifications (#29); senior developer configures actual provider credentials.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_AI_ENABLED=false
NOTIFICATION_AI_API_KEY=
NOTIFICATION_AI_MODEL=
NOTIFICATION_AI_DAILY_LIMIT=10

# CMS "Improve with AI" drafts (Trello #33-#35); human approval always required
CMS_AI_ENABLED=false
CMS_AI_API_KEY=
CMS_AI_MODEL=gpt-6.1-sol
CMS_AI_DAILY_LIMIT=20
# Monetary execution stays blocked until a positive EUR-micro cap and current reviewed pricing are configured.
CMS_AI_DAILY_BUDGET_MICROS=0
# JSON keys: model,currency(EUR),reference,valid_until(YYYY-MM-DD UTC),context_tokens,
# input_micros_per_million,output_micros_per_million. Use verified rates/FX ceilings, never guessed values.
CMS_AI_VERIFIED_PRICING={}
CMS_AI_QUEUE_CONNECTION=database
CMS_AI_AUTO_TRANSLATE=true

# Quality Center (#37): GPT finding analysis (human review always required) and read-only production probe
QA_AI_ENABLED=false
QA_AI_API_KEY=
QA_AI_MODEL=
QA_AI_DAILY_LIMIT=50
QA_EVIDENCE_RETENTION_DAYS=365
QA_STALE_AFTER_DAYS=7
QA_PROBE_ENABLED=false
QA_PROBE_SLOW_MS=1000
APP_RELEASE_SHA=

# Optional metadata-only API monitoring (#30). Enable after migration/load review.
API_MONITORING_ENABLED=false
API_MONITORING_SAMPLE_LIMIT=50000
API_MONITORING_RETENTION_HOURS=24
API_MONITORING_MINIMUM_SAMPLES=20
API_MONITORING_ERROR_PERCENT=2
API_MONITORING_P95_MS=1000
API_MONITORING_SLOW_QUERY_MS=100

# Latest owner policy D-109: new rewards require approval plus recorded settlement.
# config/shopbonus.php enforces this; historical timing snapshots remain unchanged.
AFFILIATE_CREDIT_TIMING=on_network_settlement

# Independent backup key: base64-encoded random 32 bytes, escrow separately from APP_KEY.
BACKUPS_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=recovery
# BACKUP_STORAGE_PATH=/private/mounted/offsite-backups
BACKUP_RETENTION_DAYS=14
BACKUP_OVERDUE_MINUTES=15
BACKUP_MAX_BYTES=536870912
BACKUP_MAX_FILES=20000
BACKUP_RESTORE_CONNECTION=
# Set BACKUP_RESTORE_CONNECTION=mysql_restore only after configuring a separate restore server.
BACKUP_RESTORE_DB_HOST=
BACKUP_RESTORE_DB_PORT=3306
BACKUP_RESTORE_DB_DATABASE=information_schema
BACKUP_RESTORE_DB_USERNAME=
BACKUP_RESTORE_DB_PASSWORD=
BACKUP_RESTORE_SSL_CA=
QUEUE_STALL_SECONDS=300
PROVIDER_FAILURE_THRESHOLD=3

# Merchant Shopify app authorization; senior configures, default disabled.
SHOPIFY_OAUTH_ENABLED=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Explicit allowlist of workspace connection ULIDs; no discovery while disabled/empty.
INTEGRATION_SYNC_ENABLED=false
INTEGRATION_SYNC_CONNECTIONS=

# Optional per-shop Shopify app webhook provisioning after OAuth.
SHOPIFY_WEBHOOK_SETUP_ENABLED=false

# Optional Wix OAuth app: mint 4-hour app-instance tokens instead of manual tokens.
WIX_APP_ENABLED=false
WIX_APP_ID=
WIX_APP_SECRET=

# Optional Shopware app-system registration (manifest <setup> URLs point at /api/v1/integrations/shopware/app/...).
SHOPWARE_APP_ENABLED=false
SHOPWARE_APP_NAME=
SHOPWARE_APP_SECRET=

# Release hardening (Trello #22). TLS-terminating proxies (comma list or *) and HSTS max-age (0 disables).
TRUSTED_PROXIES=
HSTS_MAX_AGE=31536000

# Central notification email destinations, relative to FRONTEND_URL.
NOTIFICATION_BENEFITS_PATH=/mijn-voordelen
NOTIFICATION_WORKSPACE_PATH=/dashboard
NOTIFICATION_PLATFORM_PATH=/admin
NOTIFICATION_SUPPORT_PATH=/app/support
NOTIFICATION_WORKSPACE_SUPPORT_PATH=/dashboard/support

# Queues whose backlog the operations overview watches (comma-separated).
RELIABILITY_MONITORED_QUEUES=default,affiliate,cms-translations,cms-media
# Additional connection/queue targets (JSON); restart workers after changing this configuration.
# RELIABILITY_MONITORED_CONNECTIONS='{"redis":["financial","notifications"],"database":["integrations"]}'

# CMS suggestions stay private drafts; use a bounded database queue worker.
# Optional model prices (EUR per million tokens) for the support AI cost estimate; leave empty when unknown.
SUPPORT_AI_PRICE_EUR_PER_MILLION_INPUT=
SUPPORT_AI_PRICE_EUR_PER_MILLION_OUTPUT=

# Optional configuration catalogue. These are commented: omitting them preserves
# each config file's default. Set only for the selected driver/integration; do not
# uncomment the whole catalogue (empty values can override working defaults).
# Provider credentials must come from the deployment secret store.
